#!/bin/bash
# =============================================================================
# run_latency_mix.job — SEARCH LATENCY vs WRITE FRACTION for two-hop (3),
# approx (4), and naive tombstone (6). Produces one graph: search p99 latency vs
# write fraction, one line per delete model. Runs at 40 threads. CPU-only.
#
#   sbatch run_latency_mix.job ; tail -f cwolverine-latmix-<jobid>.out
# =============================================================================
#SBATCH --job-name=cwolverine-latmix
#SBATCH --output=cwolverine-latmix-%j.out
#SBATCH --error=cwolverine-latmix-%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --time=03:00:00
#SBATCH --mem=32G
#SBATCH --partition=batch
#SBATCH --cpus-per-task=40
#SBATCH --account=pod-users

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
echo "Host: $(hostname)  CPUs: ${SLURM_CPUS_PER_TASK:-?}  Job: ${SLURM_JOB_ID:-n/a}"

# --- compiler (same self-detect as the other jobs) --------------------------
have_cxx17() { g++ -std=c++17 -x c++ -E - >/dev/null 2>&1 <<<'int main(){return 0;}'; }
if ! command -v g++ >/dev/null 2>&1 || ! have_cxx17; then
  if [ -n "${GCC_MODULE:-}" ]; then module load "$GCC_MODULE" 2>/dev/null || true
  else for m in gcc gnu gcc-toolset/12 gcc/12 gcc/11 gcc/10 gcc/9; do module load "$m" 2>/dev/null && break || true; done
  fi
fi
command -v g++ >/dev/null 2>&1 && have_cxx17 || { echo "ERROR: no C++17 g++" >&2; exit 1; }
echo "Compiler: $(g++ --version | head -1)"

# NUMA interleave across sockets (A/B with --export=ALL,NUMA_INTERLEAVE=0)
if [ "${NUMA_INTERLEAVE:-1}" = "1" ] && command -v numactl >/dev/null 2>&1; then
  export NUMACTL="numactl --interleave=all"; else export NUMACTL=""; fi
echo "NUMA wrapper: '${NUMACTL:-<none>}'"

# IMPORTANT: rebuild from scratch so a stale binary can't mask source changes.
make clean
make interleaved

JID="${SLURM_JOB_ID:-local}"
export MODELS="${MODELS:-3 4 6}"
export WRITE_FRACS="${WRITE_FRACS:-0 20 40 60 80}"
export THREADS="${THREADS:-40}"
export INITIAL_ACTIVE="${INITIAL_ACTIVE:-40000}"
export TOTAL_OPS="${TOTAL_OPS:-400000}"
export REPEATS="${REPEATS:-3}"
export EFS="${EFS:-200}"
export OUT="latency_vs_mix_${JID}.csv"
export RUNDIR="latency_vs_mix_runs_${JID}"

echo "### search latency vs write fraction  models=[$MODELS] fracs=[$WRITE_FRACS] threads=$THREADS ef=$EFS repeats=$REPEATS ###"
bash ./latency_vs_mix.sh

if command -v python3 >/dev/null 2>&1 && python3 -c "import matplotlib" 2>/dev/null; then
  python3 plot_latency_vs_mix.py "$OUT" -o "latency_vs_mix_${JID}.png" \
    --title "Search p99 latency vs write fraction (SIFT, ${THREADS} threads)" || true
  # also emit a p95 view
  python3 plot_latency_vs_mix.py "$OUT" --metric search_p95_ms -o "latency_vs_mix_${JID}_p95.png" \
    --title "Search p95 latency vs write fraction (SIFT, ${THREADS} threads)" || true
else
  echo "(matplotlib missing — copy $OUT locally and run plot_latency_vs_mix.py)"
fi

echo; echo "================ results ===================="
cat "$OUT"
echo "============================================="
echo "CSV: $OUT    PNG: latency_vs_mix_${JID}.png (+_p95)"
